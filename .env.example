# Copy to .env (same folder) and fill in. .env is ignored by git.
# Read by the Python service at start (npm run dev / npm start); restart after changes.

# AI rendering (Rendering step → Render). Required.
OPENAI_API_KEY=

# Optional
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare   # gpt-image-2.5-sunburst: slower, more precise edits
# OPENAI_IMAGE_QUALITY=high                # low | medium | high | auto (2.5 models also xhigh | max)
# OPENAI_IMAGE_INPUT_FIDELITY=high         # only sent to gpt-image-1 / 1.5 (default high); never to gpt-image-2 / 2.5
# FACADE_PROMPTS_DIR=/path/to/prompts      # default: prompts/ in this folder (render.txt, render-context.txt)
