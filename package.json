{
    "name": "house-viewer",
    "version": "0.0.0",
    "private": true,
    "description": "A PlayCanvas TypeScript project",
    "type": "module",
    "scripts": {
    "build": "vite build",
    "dev": "vite",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "materials:check": "node scripts/check-materials.mjs",
    "materials:import": "python3 scripts/import-material.py",
    "start": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
    "dependencies": {
        "playcanvas": "^2.22.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0-beta.8",
        "eslint": "^9.39.5",
        "prettier": "^3.9.6",
        "typescript": "~6.0.3",
        "vite": "^8.2.2"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
